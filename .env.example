# Supabase — public browser-safe values
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY-HERE

# Notes:
#   - These two values ARE safe to expose in the browser. Supabase RLS protects your data.
#   - NEVER put the service-role key in any VITE_ variable.
#   - The real values go in .env.local, which is gitignored.